# Whitelist: Roland's firmware, unpacked images, disassembly and test builds can never be added.
/*
!/.gitignore
!/README.md
!/LICENSE
!/ROADMAP.md
!/CHECKSUM_NOTES.md
!/octa_fw.py
!/tools/
!/art/
!/docs/
!/re/
!/patches/
!/app/
!/dual/
/dual/_sdk/
/dual/build/
/patches/*
!/patches/*.S
!/patches/*.c
!/patches/*.h
!/patches/remote_build.sh
!/patches/tests/
!/patches/*.ld
!/patches/asm.py
!/patches/remote_asm.sh
!/patches/page_build.py
/patches/*_pp.S
/re/*
!/re/*.md
/art/*
!/art/rosetta_splash_v*_128x64.png
!/art/rosetta_splash_v*_preview.png
!/art/rosetta_splash_candidates.png
!/art/rosetta_splash_v3_v4_preview.png
!/art/app/
/art/app/*
!/art/app/tube/
!/art/app/icons/
!/art/app/app_icon.png
!/art/app/app_icon.ico
!/art/app/shot_v*.png
!/art/screens/
/art/screens/*
!/art/screens/channel_before_after.png
__pycache__/
*.dat
*.bin
*.dis
*.zip
tools/*_memprobe.json
/app/tracks.json
/app/__pycache__/
